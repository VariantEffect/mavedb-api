#!/usr/bin/env bash
# Targeted tests: bin/t <test path or node id> [pytest args]
# Requires a target because the full suite takes ~20 minutes; pass tests/ to run it deliberately.
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "usage: bin/t <test path or node id> [pytest args]  (pass tests/ for the full suite)" >&2
    exit 2
fi

# Use the tmpfs test database when bin/test-db has started it.
if [ -z "${MAVEDB_TEST_DB_PORT:-}" ] && command -v docker >/dev/null &&
    [ "$(docker inspect -f '{{.State.Running}}' mavedb-test-db 2>/dev/null)" = "true" ]; then
    export MAVEDB_TEST_DB_PORT=5435
fi

exec poetry run pytest "$@"
