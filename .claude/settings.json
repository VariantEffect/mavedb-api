{
  "env": {
    "AWS_PROFILE": "mavedb-agent-readonly"
  },
  "permissions": {
    "deny": [
      "Bash(* --no-verify*)",
      "Read(~/.aws/**)",
      "Read(~/.pgpass)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Edit(**/AGENTS.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/.claude/**)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(*--profile*)",
      "Bash(*AWS_PROFILE=*)",
      "Bash(eb *)",
      "Bash(*MODE=prodapi*)",
      "Bash(poetry add *)",
      "Bash(poetry remove *)",
      "Bash(poetry update*)",
      "Bash(poetry lock*)",
      "Bash(poetry -C * add *)",
      "Bash(poetry -C * remove *)",
      "Bash(poetry -C * update*)",
      "Bash(poetry -C * lock*)",
      "Bash(npm install*)",
      "Bash(npm uninstall *)",
      "Bash(npm update*)",
      "Bash(npm --prefix * install*)",
      "Bash(npm --prefix * uninstall *)",
      "Bash(npm --prefix * update*)",
      "Bash(*pip install *)"
    ]
  }
}
